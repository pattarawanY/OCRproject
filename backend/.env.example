DATABASE_URL=postgresql+psycopg://smartclaim:smartclaim@localhost:5432/smartclaim
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# OCR / Translation: "mock" (ข้อมูลจำลอง) หรือ "google" (ใช้ Google Cloud จริง)
OCR_PROVIDER=mock
TRANSLATE_PROVIDER=mock
# path ไปยังไฟล์ service account JSON ของ Google Cloud (ต้องเปิด Vision API และ Translation API)
GOOGLE_APPLICATION_CREDENTIALS=

# SMTP — เว้นว่าง SMTP_HOST ไว้เพื่อปิดการส่งอีเมล (จะเขียนลง log แทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CS SmartClaim <no-reply@smartclaim.local>
SMTP_USE_TLS=true

# ฟอนต์ภาษาไทยสำหรับ PDF เช่น C:/Windows/Fonts/tahoma.ttf
PDF_FONT_PATH=
